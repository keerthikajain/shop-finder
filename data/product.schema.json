      "properties": {
        "field": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "source": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "checked_by": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Checked By",
          "type": "string"
        },
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        }
      },
      "required": [
        "field",
        "source",
        "checked_by",
        "checked_at"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
