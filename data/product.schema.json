          "maxLength": 500,
          "minLength": 1,
          "title": "Rack",
          "type": "string"
        },
        "shelf": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Shelf",
          "type": "string"
        },
        "box": {
          "maxLength": 500,
          "minLength": 1,
