# Reference only. The launcher prompts for secrets; this file is not auto-loaded.
# Production starts with an empty catalogue. Only set true for isolated synthetic testing.
# Prisma V3 adds automatic language detection, code-mix output and keyword hints.
# For an account limited to V2.5, explicitly choose prisma-v2.5 (Auto and V3-only styles are disabled).
GNANI_STT_MODEL=prisma-v3.0
GNANI_ENABLED=false
GNANI_API_KEY=
# Timbre v3 Prakash is the default spoken guide. Set v2.5 to roll back to legacy per-language voices.
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Prakash
SHOP_FINDER_SEED_DEMO=false
# Optional database path (preserve this database and its adjacent photos folder).
# SHOP_FINDER_DB=
# Set true only when serving the application over HTTPS.
SHOP_FINDER_SECURE_COOKIE=false
# Owner account is created interactively by scripts/start_local.py.
# Never store passwords or API keys in committed configuration.

# Optional isolated public showcase. NEVER enable on your actual store deployment.
SHOP_FINDER_PUBLIC_DEMO=false

# Optional dedicated Gnani AI challenge installation only.
# Gives every reviewer an isolated working Owner account and SQLite workspace.
# Do not enable on a deployed store or any installation containing real data.
SHOP_FINDER_CHALLENGE_SIGNUP=false
# Use a persistent writable directory separate from your live store's database.
SHOP_FINDER_CHALLENGE_DATA_DIR=
